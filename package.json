{
  "name": "finans-v1",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:unit": "node --test tests/money-calendar.test.mjs tests/dates-plan.test.mjs tests/operations-cards.test.mjs tests/accounts-directions.test.mjs tests/shared.test.mjs",
    "test": "npm run build && npm run test:unit && npm run test:sites",
    "release:package": "npm run build && python3 scripts/package-release.py",
    "test:api": "python3 scripts/test-integration.py api",
    "test:migrations": "python3 scripts/test-integration.py migrations",
    "test:browser": "python3 scripts/test-integration.py browser",
    "test:package": "python3 scripts/test-integration.py package"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.57.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "^3.10.1",
    "vite": "6.4.4"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
