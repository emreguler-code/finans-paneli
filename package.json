{
  "name": "finans-v1",
  "version": "1.27.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:unit": "node --test tests/money-calendar.test.mjs tests/dates-plan.test.mjs tests/operations-cards.test.mjs tests/accounts-directions.test.mjs tests/shared.test.mjs tests/tracking.test.mjs tests/notifications.test.mjs tests/refinements.test.mjs tests/navigation-search.test.mjs tests/bank-directory.test.mjs tests/party-ledger.test.mjs tests/search-query.test.mjs tests/sorting.test.mjs tests/party-monthly.test.mjs tests/audit.test.mjs tests/record-target.test.mjs",
    "test": "npm run lint && npm run format:check && npm run build && npm run test:unit && npm run test:sites",
    "release:package": "npm run build && python3 scripts/package-release.py",
    "test:api": "python3 scripts/test-integration.py api",
    "test:migrations": "python3 scripts/test-integration.py migrations",
    "test:browser": "python3 scripts/test-integration.py browser",
    "test:demo": "python3 scripts/test-integration.py demo",
    "demo:stop": "python3 scripts/stop-demo.py",
    "demo:start": "python3 scripts/test-integration.py demo --keep",
    "test:package": "python3 scripts/test-integration.py package",
    "test:backups": "python3 scripts/test-integration.py backups",
    "test:mobile": "python3 scripts/test-integration.py mobile",
    "test:party-ui": "node tests/party120-browser.cjs",
    "lint": "eslint src && stylelint \"src/styles/**/*.css\"",
    "test:layout": "node tests/layout121-browser.cjs",
    "format:check": "node scripts/format.mjs --check",
    "format": "node scripts/format.mjs --write",
    "audit:security": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "lucide-react": "1.74.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@prettier/plugin-php": "0.26.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.14.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "stylelint": "18.0.0"
  },
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=12.2.2 <13"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "packageManager": "npm@12.2.2"
}
